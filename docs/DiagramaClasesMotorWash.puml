@startuml
title MotorWash - Diagrama de Clases UML (Consolidado)

left to right direction
hide empty members
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Dominio" {
  class Usuario <<Entity>> {
    +id: String
    +nombre: String
    +email: String
    +telefono: String
    +rol: String
    +fechaRegistro: String
  }

  class Vehiculo <<Entity>> {
    +id: String
    +tipo: String
    +marca: String
    +color: String
    +placa: String
    +userId: String
  }

  class Servicio <<Entity>> {
    +id: String
    +titulo: String
    +descripcion: String
    +precio: Number
    +tiempoEstimado: Number
    +tipoVehiculo: String
  }

  class Visita <<Entity>> {
    +id: String
    +fecha: String
    +tipoLavado: String
    +tiempoEstimado: Number
    +precio: Number
    +encargado: String
    +vehiculo: String
    +estado: String
    +fechaCreado: String
    +horaInicio: Number
    +calificacion: Number
    +comentario: String
    +userId: String
  }

  class StateRules <<Utility>> {
    {static} +TRANSICIONES_PERMITIDAS: Map
    {static} +ETIQUETAS_ESTADO: Map
    {static} +validarTransicionEstado(estadoActual, estadoNuevo)
    {static} +validarNuevaVisita(visitaData)
  }

  class PlateRules <<Utility>> {
    {static} +PATRON_PARTICULAR: RegExp
    {static} +PATRON_MOTO: RegExp
    {static} +normalizarPlaca(placa)
    {static} +validarPlaca(placa)
    {static} +validarDatosVehiculo(tipo, marca, color, placa)
  }

  class PricingRules <<Utility>> {
    {static} +TIPOS_VEHICULO: Map
    {static} +servicioAplicaParaVehiculo(tipoServicio, tipoVehiculoCliente)
    {static} +calcularPrecioFinal(precioBase)
  }
}

package "Aplicación (Use Cases)" {
  class RegisterVehicleUseCase <<ApplicationService>> {
    {static} +registerVehicleUseCase(vehiculoData, userId)
  }

  class AddVisitUseCase <<ApplicationService>> {
    {static} +addVisitUseCase(nuevaVisita, userId)
  }

  class UpdateVisitStatusUseCase <<ApplicationService>> {
    {static} +iniciarVisitaUseCase(visitaId, estadoActual, nombreEncargado)
    {static} +completarVisitaUseCase(visitaId, estadoActual)
    {static} +calificarVisitaUseCase(visitaId, estrellas, comentario)
  }
}

package "Infraestructura (Repositorios Firebase)" {
  class AuthRepository <<Repository>> {
    {static} +registerUserInDB(email, password, nombre, telefono)
    {static} +loginUser(email, password)
    {static} +updateProfileInDB(uid, datosNuevos)
    {static} +changeUserPassword(newPassword)
    {static} +logoutUser()
    {static} +listenToAuthChanges(onUserChange)
  }

  class UsersRepository <<Repository>> {
    {static} +listenToUsers(onDataUpdate)
    {static} +updateUserRoleInDB(usuarioId, nuevoRol)
  }

  class VehiclesRepository <<Repository>> {
    {static} +listenToUserVehicles(userId, onDataUpdate)
    {static} +createVehicleInDB(vehiculoData, userId)
    {static} +updateVehicleInDB(vehiculoId, nuevosDatos)
    {static} +deleteVehicleFromDB(vehiculoId)
  }

  class ServicesRepository <<Repository>> {
    {static} +listenToServices(onDataUpdate)
    {static} +createServiceInDB(nuevoServicio)
    {static} +updateServiceInDB(servicioId, nuevosDatos)
  }

  class VisitsRepository <<Repository>> {
    {static} +listenToUserVisits(user, onDataUpdate)
    {static} +crearVisitaInDB(visitaData, userId)
    {static} +iniciarVisitaInDB(visitaId, nombreEmpleado)
    {static} +completarVisitaInDB(visitaId)
    {static} +calificarVisitaInDB(visitaId, calificacion, comentario)
  }
}

package "Infraestructura Nativa" {
  class NativeBridge <<Adapter>> {
    {static} +isKotlinAvailable: boolean
    {static} +calcularPrecioFinal(precioBase, tipoVehiculo)
    {static} +validarNuevaVisita(visitaData)
    {static} +validarTransicionEstado(estadoActual, estadoNuevo)
    {static} +validarPlaca(placa)
    {static} +validarDatosVehiculo(tipo, marca, color, placa)
    {static} +clasificarVehiculo(tipoVehiculo)
  }
}

' Relaciones del dominio
Usuario "1" -- "0..*" Vehiculo : posee
Usuario "1" -- "0..*" Visita : solicita
Visita ..> Vehiculo : snapshot textual
Visita ..> Servicio : tipoLavado/precio

PlateRules ..> Vehiculo : valida
StateRules ..> Visita : valida
PricingRules ..> Servicio : aplica reglas

' Orquestación de aplicación
RegisterVehicleUseCase ..> NativeBridge : valida
RegisterVehicleUseCase ..> VehiclesRepository : persiste

AddVisitUseCase ..> NativeBridge : valida
AddVisitUseCase ..> VisitsRepository : persiste

UpdateVisitStatusUseCase ..> NativeBridge : valida transición
UpdateVisitStatusUseCase ..> VisitsRepository : actualiza estado

' Repositorios y entidades persistidas
AuthRepository ..> Usuario
UsersRepository ..> Usuario
VehiclesRepository ..> Vehiculo
ServicesRepository ..> Servicio
VisitsRepository ..> Visita

note bottom
En el código JavaScript, los "use cases", repositorios y bridge se implementan
como módulos con funciones exportadas; en UML se modelan como operaciones estáticas.
end note

@enduml
